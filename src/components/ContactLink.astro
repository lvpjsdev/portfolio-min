---
interface Props {
  type: 'email' | 'linkedin' | 'github' | 'instagram';
  label: string;
  value: string;
}

const { type, label, value } = Astro.props;

const href = type === 'email' ? `mailto:${value}` : value;
const isExternal = type !== 'email';
---

<a
  href={href}
  class="contact-link"
  {...isExternal ? { target: '_blank', rel: 'noopener noreferrer' } : {}}
  aria-label={label}
>
  <span class="contact-icon">
    {type === 'email' && (
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <rect width="20" height="16" x="2" y="4" rx="2"/>
        <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
      </svg>
    )}
    {type === 'linkedin' && (
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/>
        <rect width="4" height="12" x="2" y="9"/>
        <circle cx="4" cy="4" r="2"/>
      </svg>
    )}
    {type === 'github' && (
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/>
        <path d="M9 18c-4.51 2-5-2-7-2"/>
      </svg>
    )}
    {type === 'instagram' && (
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <rect width="20" height="20" x="2" y="2" rx="5" ry="5"/>
        <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/>
        <line x1="17.5" x2="17.51" y1="6.5" y2="6.5"/>
      </svg>
    )}
    {type !== 'email' && type !== 'linkedin' && type !== 'github' && type !== 'instagram' && (
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/>
        <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/>
      </svg>
    )}
  </span>
  <span class="contact-label">{label}</span>
</a>

<style>
.contact-link {
     display: flex;
     align-items: center;
     gap: 16px;
     padding: var(--spacing-md) var(--spacing-lg);
     border-radius: var(--border-radius-lg);
    background: var(--color-background-surface);
    text-decoration: none;
    color: var(--color-text-primary);
    width: 320px;
    transition: transform var(--duration-normal) ease, box-shadow var(--duration-normal) ease;
    position: relative;
    overflow: hidden;
    /* Depth: multiple shadow layers */
    box-shadow:
      0 2px 8px rgba(244, 96, 54, 0.06),
      0 4px 16px rgba(0, 0, 0, 0.1);
  }

  .contact-link::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-image: url("data:image/svg+xml,%3Csvg width='200' height='200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.7' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='200' height='200' filter='url(%23n)' opacity='0.025'/%3E%3C/svg%3E");
    pointer-events: none;
    z-index: 0;
  }

  .contact-link:hover {
    transform: translateY(-2px);
    box-shadow:
      0 4px 12px rgba(244, 96, 54, 0.1),
      0 8px 24px rgba(0, 0, 0, 0.15);
  }

  .contact-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    color: var(--color-interactive-primary);
    width: 24px;
    height: 24px;
  }

  .contact-label {
    font-size: var(--font-size-xs);
    color: var(--color-text-primary);
  }
</style>
