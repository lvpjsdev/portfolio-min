---
interface Props {
  active: boolean;
  href: string;
  label: string;
}

const { active, href, label } = Astro.props;
---

<a
  href={href}
  class:list={['nav-dot', { 'nav-dot--active': active }]}
  aria-label={label}
  aria-current={active ? 'page' : undefined}
></a>

<style>
  .nav-dot {
    display: block;
    width: 10px;
    height: 10px;
    border-radius: var(--border-radius-full);
    background-color: var(--color-primitive-twilight-indigo);
    transition: transform var(--duration-fast) ease, background-color var(--duration-fast) ease;
    flex-shrink: 0;
    text-decoration: none;
  }

  .nav-dot--active {
    background-color: var(--color-primitive-white);
  }

  .nav-dot:hover {
    transform: scale(1.5);
  }
</style>
