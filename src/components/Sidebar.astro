---
import NavDot from './NavDot.astro';

interface Props {
  currentPage: 'home' | 'about' | 'experience' | 'projects' | 'skills' | 'contact';
}

const { currentPage } = Astro.props;

const navItems = [
  { id: 'home',       href: '/',           label: 'Home' },
  { id: 'about',      href: '/about',      label: 'About Me' },
  { id: 'experience', href: '/experience', label: 'Work Experience' },
  { id: 'projects',   href: '/projects',   label: 'Projects' },
  { id: 'skills',     href: '/skills',     label: 'Skills' },
  { id: 'contact',    href: '/contact',    label: 'Contact' },
] as const;
---

<!-- Desktop sidebar (≥ 768px) -->
<nav class="sidebar" aria-label="Main navigation">
  <ul class="sidebar__list" role="list">
    {navItems.map((item) => (
      <li>
        <a
          href={item.href}
          class:list={['sidebar__nav-item', { 'sidebar__nav-item--active': currentPage === item.id }]}
          aria-current={currentPage === item.id ? 'page' : undefined}
          aria-label={item.label}
        >
          <NavDot active={currentPage === item.id} />
          <span class="nav-label">{item.label}</span>
        </a>
      </li>
    ))}
  </ul>
</nav>

<!-- Mobile top navbar (< 768px) -->
<nav class="mobile-nav" aria-label="Mobile navigation">
  <ul class="mobile-nav__list" role="list">
    {navItems.map((item) => (
      <li>
        <a
          href={item.href}
          class:list={['mobile-nav__link', { 'mobile-nav__link--active': currentPage === item.id }]}
          aria-current={currentPage === item.id ? 'page' : undefined}
        >
          {item.label}
        </a>
      </li>
    ))}
  </ul>
</nav>

<style>
  /* ─── Desktop Sidebar ─────────────────────────────────────────── */
  .sidebar {
    position: fixed;
    left: 0;
    top: 0;
    width: 64px;
    height: 100vh;
    background-color: var(--color-background-surface);
    z-index: 100;
    overflow: hidden;
    transition: width var(--duration-normal) ease, box-shadow var(--duration-normal) ease;
  }

  .sidebar:hover {
    width: 240px;
    box-shadow: 4px 0 24px rgba(0, 0, 0, 0.4);
  }

  .sidebar__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 20px;
    width: 64px;        /* фиксированная ширина — точки всегда по центру 64px */
    height: 100%;
  }

  .sidebar:hover .sidebar__list {
    width: 200px;       /* expanded: ширина контента (240 - 20px padding с каждой стороны) */
    padding: 32px 20px;
    gap: 32px;
  }

  /* NavItem wrapper — wraps NavDot + label */
  .sidebar__nav-item {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;  /* collapsed: точка по центру 64px */
    gap: 10px;
    padding: 8px 0;
    text-decoration: none;
    color: var(--color-primitive-silver-mist);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-normal);
    white-space: nowrap;
    transition: color var(--duration-fast) ease;
  }

  .sidebar:hover .sidebar__nav-item {
    justify-content: flex-start;  /* expanded: по левому краю */
  }

  .sidebar__nav-item--active {
    color: var(--color-primitive-white);
    font-weight: var(--font-weight-bold);
  }

  .sidebar__nav-item:hover {
    color: var(--color-primitive-white);
    font-weight: var(--font-weight-medium);
  }

  /* Text label — скрыт в collapsed, виден при hover */
  .nav-label {
    width: 0;
    overflow: hidden;
    opacity: 0;
    white-space: nowrap;
    transition: opacity var(--duration-fast) ease;
    pointer-events: none;
  }

  .sidebar:hover .nav-label {
    width: auto;
    opacity: 1;
  }

  /* ─── Mobile Navbar ───────────────────────────────────────────── */
  .mobile-nav {
    display: none;
  }

  @media (max-width: 767px) {
    .sidebar {
      display: none;
    }

    .mobile-nav {
      display: block;
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      height: 56px;
      background-color: var(--color-background-surface);
      z-index: 100;
      box-shadow: 0 2px 12px rgba(0, 0, 0, 0.3);
    }

    .mobile-nav__list {
      list-style: none;
      margin: 0;
      padding: 0 16px;
      display: flex;
      flex-direction: row;
      align-items: center;
      justify-content: space-around;
      height: 100%;
      gap: 4px;
    }

    .mobile-nav__link {
      display: block;
      padding: 6px 8px;
      text-decoration: none;
      color: var(--color-text-secondary);
      font-size: var(--font-size-xs);
      font-weight: var(--font-weight-medium);
      white-space: nowrap;
      border-radius: var(--border-radius-sm);
      transition: color var(--duration-fast) ease, background-color var(--duration-fast) ease;
    }

    .mobile-nav__link--active,
    .mobile-nav__link:hover {
      color: var(--color-primitive-white);
      background-color: var(--color-primitive-twilight-indigo);
    }
  }
</style>
