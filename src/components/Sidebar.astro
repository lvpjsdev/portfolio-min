---
import { t } from '../lib/i18n';
import NavDot from './NavDot.astro';

interface Props {
  currentPage: 'home' | 'about' | 'experience' | 'projects' | 'skills' | 'contact';
  lang: string;
}

const { currentPage, lang } = Astro.props;

const localizeHref = (href: string) => href === '/' ? `/${lang}` : `/${lang}${href}`;

const navItems = [
  { id: 'home',       href: '/' },
  { id: 'about',      href: '/about' },
  { id: 'experience', href: '/experience' },
  { id: 'projects',   href: '/projects' },
  { id: 'skills',     href: '/skills' },
  { id: 'contact',    href: '/contact' },
] as const;
---

<!-- Desktop sidebar (≥ 768px) -->
<nav class="sidebar" aria-label={t(lang, 'nav.aria_main')} data-page={currentPage}>
  <ul class="sidebar__list" role="list">
    {navItems.map((item) => (
      <li>
<a
           href={localizeHref(item.href)}
           class:list={['sidebar__nav-item', { 'sidebar__nav-item--active': currentPage === item.id }]}
           aria-current={currentPage === item.id ? 'page' : undefined}
           aria-label={t(lang, 'nav.' + item.id)}
         >
           <NavDot active={currentPage === item.id} />
           <span class="nav-label">{t(lang, 'nav.' + item.id)}</span>
         </a>
      </li>
    ))}
  </ul>
</nav>

<!-- Mobile top navbar (< 768px) -->
<nav class="mobile-nav" aria-label={t(lang, 'nav.aria_mobile')}>
  <ul class="mobile-nav__list" role="list">
    {navItems.map((item) => (
      <li>
        <a
          href={localizeHref(item.href)}
          class:list={['mobile-nav__link', { 'mobile-nav__link--active': currentPage === item.id }]}
          aria-current={currentPage === item.id ? 'page' : undefined}
        >
          {t(lang, 'nav.' + item.id)}
        </a>
      </li>
    ))}
  </ul>
</nav>

<style>
  /* ─── Desktop Sidebar ─────────────────────────────────────────── */
  .sidebar {
    position: fixed;
    left: 0;
    top: 0;
    width: 64px;
    height: 100vh;
    background-color: var(--color-background-surface);
    z-index: 100;
    overflow: hidden;
    transition: width var(--duration-normal) ease, box-shadow var(--duration-normal) ease;
    border-right: 1px solid var(--color-primitive-twilight-indigo);
    box-shadow: 2px 0 8px rgba(0, 0, 0, 0.15);
    /* Depth: subtle texture overlay */
    font-family: var(--font-family-mono);
  }

  .sidebar::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-image: url("data:image/svg+xml,%3Csvg width='200' height='200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.65' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='200' height='200' filter='url(%23n)' opacity='0.03'/%3E%3C/svg%3E");
    pointer-events: none;
    z-index: 0;
  }

  .sidebar:hover {
    width: 240px;
    box-shadow: 4px 0 32px rgba(244, 96, 54, 0.15), 2px 0 16px rgba(0, 0, 0, 0.5);
  }

  .sidebar__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 20px;
    width: 64px;        /* фиксированная ширина — точки всегда по центру 64px */
    height: 100%;
    border-bottom: 1px solid rgba(65, 71, 112, 0.3); /* twilight-indigo with alpha */
  }

  .sidebar:hover .sidebar__list {
    width: 200px;       /* expanded: ширина контента (240 - 20px padding с каждой стороны) */
    padding: 32px 20px;
    gap: 32px;
  }

  /* NavItem wrapper — wraps NavDot + label */
  .sidebar__nav-item {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;  /* collapsed: точка по центру 64px */
    gap: 10px;
    padding: 8px 0;
    text-decoration: none;
    color: var(--color-primitive-silver-mist);
    font-size: var(--font-size-sm);
    font-family: var(--font-family-mono);
    font-weight: 500; /* {typography.body-strong} */
    white-space: nowrap;
    border-radius: var(--design-rounded-sm, 4px);
    transition: color var(--duration-fast) ease;
  }

  .sidebar:hover .sidebar__nav-item {
    justify-content: flex-start;  /* expanded: по левому краю */
  }

  .sidebar__nav-item--active {
    color: var(--color-primitive-white);
    font-weight: var(--font-weight-bold);
  }

  .sidebar__nav-item:hover {
    color: var(--color-primitive-white);
    font-weight: var(--font-weight-medium);
  }

  /* Text label — скрыт в collapsed, виден при hover */
  .nav-label {
    width: 0;
    overflow: hidden;
    opacity: 0;
    white-space: nowrap;
    transition: opacity var(--duration-fast) ease;
    pointer-events: none;
  }

  .sidebar:hover .nav-label {
    width: auto;
    opacity: 1;
  }

  /* ─── Mobile Navbar ───────────────────────────────────────────── */
  .mobile-nav {
    display: none;
    font-family: var(--font-family-mono);
  }

  @media (max-width: 767px) {
    .sidebar {
      display: none;
    }

    .mobile-nav {
      display: block;
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      height: 56px;
      background-color: var(--color-background-surface);
      z-index: 100;
      box-shadow: 0 2px 12px rgba(0, 0, 0, 0.3);
    }

    .mobile-nav__list {
      list-style: none;
      margin: 0;
      padding: 0 16px;
      display: flex;
      flex-direction: row;
      align-items: center;
      justify-content: space-around;
      height: 100%;
      gap: 4px;
    }

    .mobile-nav__link {
      display: block;
      padding: 6px 8px;
      text-decoration: none;
      color: var(--color-text-secondary);
      font-size: var(--font-size-xs);
      font-family: var(--font-family-mono);
      font-weight: var(--font-weight-medium);
      white-space: nowrap;
      border-radius: var(--design-rounded-sm, 4px);
      transition: color var(--duration-fast) ease, background-color var(--duration-fast) ease;
    }

    .mobile-nav__link--active,
    .mobile-nav__link:hover {
      color: var(--color-primitive-white);
      background-color: var(--color-primitive-twilight-indigo);
    }
  }
</style>
