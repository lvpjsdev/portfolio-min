---
import NavDot from './NavDot.astro';

interface Props {
  currentPage: 'home' | 'about' | 'experience' | 'projects' | 'skills' | 'contact';
}

const { currentPage } = Astro.props;

const pathname = Astro.url?.pathname || '/';
const lang = pathname.startsWith('/ru') ? 'ru' : 'en';
const t = lang === 'ru'
  ? (await import('../locales/ru.json')).default
  : (await import('../locales/en.json')).default;

const navItems = [
  { id: 'home',       href: `/${lang}`,           label: t.nav.home },
  { id: 'about',      href: `/${lang}/about`,      label: t.nav.about },
  { id: 'experience', href: `/${lang}/experience`, label: t.nav.experience },
  { id: 'projects',   href: `/${lang}/projects`,   label: t.nav.projects },
  { id: 'skills',     href: `/${lang}/skills`,     label: t.nav.skills },
  { id: 'contact',    href: `/${lang}/contact`,    label: t.nav.contact },
] as const;
---

<!-- Desktop sidebar (≥ 768px) -->
<nav class="sidebar" aria-label="Main navigation" data-page={currentPage}>
  <ul class="sidebar__list" role="list">
    {navItems.map((item) => (
      <li>
<a
           href={item.href}
           class:list={['sidebar__nav-item', { 'sidebar__nav-item--active': currentPage === item.id }]}
           aria-current={currentPage === item.id ? 'page' : undefined}
           aria-label={item.label}
         >
           <NavDot active={currentPage === item.id} />
           <span class="nav-label">{item.label}</span>
         </a>
      </li>
    ))}
  </ul>
</nav>

<!-- Mobile top navbar (< 768px) -->
<nav class="mobile-nav" aria-label="Mobile navigation">
  <ul class="mobile-nav__list" role="list">
    {navItems.map((item) => (
      <li>
        <a
          href={item.href}
          class:list={['mobile-nav__link', { 'mobile-nav__link--active': currentPage === item.id }]}
          aria-current={currentPage === item.id ? 'page' : undefined}
        >
          {item.label}
        </a>
      </li>
    ))}
  </ul>
</nav>

<script>
  const sidebar = document.querySelector('.sidebar');
  if (sidebar) {
    let mouseInside = false;

    sidebar.addEventListener('mouseenter', () => {
      mouseInside = true;
      sidebar.classList.add('sidebar--expanded');
    });

    sidebar.addEventListener('mouseleave', () => {
      mouseInside = false;
      sidebar.classList.remove('sidebar--expanded');
    });

    document.addEventListener('mousemove', (e) => {
      const rect = sidebar.getBoundingClientRect();
      const isOverSidebar = e.clientX >= rect.left && e.clientX <= rect.right &&
                            e.clientY >= rect.top  && e.clientY <= rect.bottom;

      if (isOverSidebar !== mouseInside) {
        mouseInside = isOverSidebar;
        if (isOverSidebar) {
          sidebar.classList.add('sidebar--expanded');
        } else {
          sidebar.classList.remove('sidebar--expanded');
        }
      }
    });
  }
</script>

<style>
  /* ─── Desktop Sidebar ─────────────────────────────────────────── */
  .sidebar {
    position: fixed;
    left: 0;
    top: 0;
    width: 64px;
    height: 100vh;
    background-color: var(--color-background-surface);
    z-index: 100;
    overflow: hidden;
    transition: width var(--duration-normal) ease, box-shadow var(--duration-normal) ease;
    border-right: 1px solid var(--color-primitive-twilight-indigo);
    box-shadow: 2px 0 8px rgba(0, 0, 0, 0.15);
    font-family: var(--font-family-mono);
  }

  .sidebar::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-image: url("data:image/svg+xml,%3Csvg width='200' height='200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.65' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='200' height='200' filter='url(%23n)' opacity='0.03'/%3E%3C/svg%3E");
    pointer-events: none;
    z-index: 0;
  }

  .sidebar--expanded,
  .sidebar:hover {
    width: 200px;
    box-shadow: 4px 0 32px rgba(244, 96, 54, 0.15), 2px 0 16px rgba(0, 0, 0, 0.5);
  }

  .sidebar__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 20px;
    width: 64px;
    height: 100%;
    border-bottom: 1px solid rgba(65, 71, 112, 0.3);
    transition: padding var(--duration-normal) ease, gap var(--duration-normal) ease;
  }

  .sidebar--expanded .sidebar__list,
  .sidebar:hover .sidebar__list {
    width: 160px;
    padding: 32px 20px;
    gap: 32px;
  }

  /* NavItem wrapper — wraps NavDot + label */
  .sidebar__nav-item {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding: 8px 0;
    text-decoration: none;
    color: var(--color-primitive-silver-mist);
    font-size: var(--font-size-sm);
    font-family: var(--font-family-mono);
    font-weight: 500;
    white-space: nowrap;
    border-radius: var(--design-rounded-sm, 4px);
    transition: color var(--duration-fast) ease;
  }

  .sidebar--expanded .sidebar__nav-item,
  .sidebar:hover .sidebar__nav-item {
    justify-content: flex-start;
  }

  .sidebar__nav-item--active {
    color: var(--color-primitive-white);
    font-weight: var(--font-weight-bold);
  }

  .sidebar__nav-item:hover {
    color: var(--color-primitive-white);
    font-weight: var(--font-weight-medium);
  }

  .nav-label {
    width: 0;
    overflow: hidden;
    opacity: 0;
    white-space: nowrap;
    transition: opacity var(--duration-fast) ease, width var(--duration-normal) ease;
    pointer-events: none;
  }

  .sidebar--expanded .nav-label,
  .sidebar:hover .nav-label {
    width: auto;
    opacity: 1;
  }

  /* ─── Mobile Navbar ───────────────────────────────────────────── */
  .mobile-nav {
    display: none;
    font-family: var(--font-family-mono);
  }

  @media (max-width: 767px) {
    .sidebar {
      display: none;
    }

    .mobile-nav {
      display: block;
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      height: 56px;
      background-color: var(--color-background-surface);
      z-index: 100;
      box-shadow: 0 2px 12px rgba(0, 0, 0, 0.3);
    }

    .mobile-nav__list {
      list-style: none;
      margin: 0;
      padding: 0 16px;
      display: flex;
      flex-direction: row;
      align-items: center;
      justify-content: space-around;
      height: 100%;
      gap: 4px;
    }

    .mobile-nav__link {
      display: block;
      padding: 6px 8px;
      text-decoration: none;
      color: var(--color-text-secondary);
      font-size: var(--font-size-xs);
      font-family: var(--font-family-mono);
      font-weight: var(--font-weight-medium);
      white-space: nowrap;
      border-radius: var(--design-rounded-sm, 4px);
      transition: color var(--duration-fast) ease, background-color var(--duration-fast) ease;
    }

    .mobile-nav__link--active,
    .mobile-nav__link:hover {
      color: var(--color-primitive-white);
      background-color: var(--color-primitive-twilight-indigo);
    }
  }
</style>
