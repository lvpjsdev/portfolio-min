---
// ThemeToggle.astro — standalone component, no props
---

<button class="theme-toggle" aria-label="Toggle theme" type="button">
  <!-- Moon icon — shown in dark theme -->
  <span class="icon-moon">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
    </svg>
  </span>
  <!-- Sun icon — shown in light theme -->
  <span class="icon-sun">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <circle cx="12" cy="12" r="4"/>
      <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/>
    </svg>
  </span>
  <!-- Label — "Dark" in dark theme, "Light" in light theme -->
  <span class="label-dark">Dark</span>
  <span class="label-light">Light</span>
</button>

<style>
.theme-toggle {
     display: flex;
     align-items: center;
     gap: 6px;
     padding: 6px 10px;
     border-radius: var(--border-radius-20);
    background: var(--color-primitive-twilight-indigo);
    color: var(--color-primitive-white);
    font-size: var(--font-size-xs);
    font-family: var(--font-family-mono);
    border: none;
    cursor: pointer;
    transition: opacity var(--duration-fast) ease, box-shadow var(--duration-fast) ease, transform var(--duration-fast) ease;
    line-height: 1;
    position: relative;
    overflow: hidden;
    /* Depth: subtle shadow */
    box-shadow: none;
  }

  .theme-toggle::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-image: url("data:image/svg+xml,%3Csvg width='100' height='100' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.8' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100' height='100' filter='url(%23n)' opacity='0.02'/%3E%3C/svg%3E");
    pointer-events: none;
    z-index: 0;
  }

  .theme-toggle:hover {
    opacity: 0.85;
    transform: translateY(-1px);
    box-shadow: none;
  }

  /* Default state: dark theme active — show moon + "Dark", hide sun + "Light" */
  .icon-sun,
  .label-light {
    display: none;
  }

  .icon-moon,
  .label-dark {
    display: contents;
  }

  /* When light theme is active — show sun + "Light", hide moon + "Dark" */
  :global([data-theme="light"]) .icon-sun,
  :global([data-theme="light"]) .label-light {
    display: contents;
  }

  :global([data-theme="light"]) .icon-moon,
  :global([data-theme="light"]) .label-dark {
    display: none;
  }

  /* Light theme button styling */
  :global([data-theme="light"]) .theme-toggle {
    background: var(--color-primitive-tiger-flame);
    color: var(--color-primitive-white);
    box-shadow: none;
  }
</style>

<script>
  (function () {
    const btn = document.querySelector('.theme-toggle') as HTMLButtonElement | null;
    if (!btn) return;

    function getInitialTheme(): 'dark' | 'light' {
      try {
        const stored = localStorage.getItem('theme');
        if (stored === 'dark' || stored === 'light') return stored;
      } catch (_) {
        // localStorage unavailable (private browsing, SSR, etc.)
      }
      // Fall back to system preference
      if (window.matchMedia && window.matchMedia('(prefers-color-scheme: light)').matches) {
        return 'light';
      }
      return 'dark';
    }

    function applyTheme(theme: 'dark' | 'light') {
      document.documentElement.setAttribute('data-theme', theme);
      try {
        localStorage.setItem('theme', theme);
      } catch (_) {
        // Ignore write errors (private browsing, storage full, etc.)
      }
    }

    // Apply theme on load
    applyTheme(getInitialTheme());

    // Toggle on click
    btn.addEventListener('click', () => {
      const current = document.documentElement.getAttribute('data-theme');
      const next: 'dark' | 'light' = current === 'light' ? 'dark' : 'light';
      applyTheme(next);
    });
  })();
</script>
