---
import { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'svg'> {
  name: string;
  icon?: string;
  size?: number;
}

const { name, icon, size = 16, ...props } = Astro.props;

const iconName = icon || name;
const basePath = `/icons/skills/${iconName}`;
---

{icon && (
  <svg
    width={size}
    height={size}
    viewBox="0 0 24 24"
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
    aria-hidden="true"
    class="skill-icon"
    {...props}
  >
    <style>
      .skill-icon image { display: none; }
      @media (prefers-color-scheme: light) {
        .skill-icon .icon-light { display: block; }
      }
      @media (prefers-color-scheme: dark) {
        .skill-icon .icon-dark { display: block; }
      }
      .skill-icon .icon-default { display: block; }
    </style>
    <image href={`${basePath}--light.svg`} width="24" height="24" class="icon-light" />
    <image href={`${basePath}--dark.svg`} width="24" height="24" class="icon-dark" />
    <image href={`${basePath}.svg`} width="24" height="24" class="icon-default" />
  </svg>
)}