---
interface Props {
  role: string;
  company: string;
  dates: string;
  achievements: string[];
  isCurrent?: boolean;
}

const { role, company, dates, achievements, isCurrent = false } = Astro.props;
---

<article
  class="experience-card"
  role="button"
  tabindex="0"
  aria-expanded="false"
  aria-label={`${role} at ${company}`}
>
  <div class="card-header">
    <div class="card-info">
      <span class="card-role">{role}</span>
      <span class="card-company">{company}</span>
      <span class="card-dates">{dates}{isCurrent && <span class="card-current"> · Current</span>}</span>
    </div>
    <span class="card-ascii-marker" aria-hidden="true">[+]</span>
  </div>
  <div class="card-body" hidden>
    <hr class="card-divider" />
    <div class="card-achievements">
      <p class="achievements-title">Key Achievements:</p>
      {achievements.map((achievement) => (
        <div class="achievement-item">
          <span class="bullet" aria-hidden="true">•</span>
          <span>{achievement}</span>
        </div>
      ))}
    </div>
  </div>
</article>

<style>
  .experience-card {
    --card-hover-bg: oklch(30% 0.05 30);

    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 20px 24px;
    border-radius: 0px;
    border: 1px solid rgba(65,71,112,0.3);
    background-color: var(--color-background-surface);
    color: var(--color-text-primary);
    cursor: pointer;
    font-family: var(--font-family-sans);
    outline: none;
    transition: transform var(--duration-normal) ease;
    position: relative;
    overflow: hidden;
  }

  .experience-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-image: url("data:image/svg+xml,%3Csvg width='200' height='200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.7' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='200' height='200' filter='url(%23n)' opacity='0.025'/%3E%3C/svg%3E");
    pointer-events: none;
    z-index: 0;
  }

  .experience-card:hover {
    transform: translateY(-2px);
  }

  .experience-card:hover,
  .experience-card:focus-visible {
    background-color: var(--card-hover-bg);
  }

  .experience-card:focus-visible {
    outline: 2px solid rgba(244, 96, 54, 0.5);
    outline-offset: 2px;
  }

  .experience-card:hover .card-ascii-marker,
  .experience-card:focus-visible .card-ascii-marker {
    color: var(--color-interactive-primary);
  }

  /* Header row */
   .card-header {
     display: flex;
     justify-content: space-between;
     align-items: center;
     gap: var(--spacing-6);
   }

   /* Info column */
   .card-info {
     display: flex;
     flex-direction: column;
     gap: 4px;
     min-width: 0;
   }

  .card-role {
    font-family: var(--font-family-display);
    font-size: var(--font-size-lg);
    font-weight: var(--font-weight-bold);
    color: var(--color-text-primary);
    line-height: 1.3;
  }

  .card-company {
    font-size: var(--font-size-base);
    color: var(--color-interactive-secondary);
    line-height: 1.3;
  }

  .card-dates {
    font-size: var(--font-size-xs);
    color: var(--color-text-secondary);
    line-height: 1.3;
  }

  .card-current {
    color: var(--color-interactive-primary);
  }

  /* Chevron */
  .card-ascii-marker {
    flex-shrink: 0;
    font-family: var(--font-family-mono);
    color: var(--color-text-secondary);
    transition: color var(--duration-fast) ease;
    font-size: var(--font-size-xs);
  }

/* Expanded state */
   .experience-card.is-expanded {
     gap: 12px;
     padding: 24px 28px;
   }

   .experience-card.is-expanded .card-chevron {
     transform: rotate(90deg);
   }

/* Body / accordion panel */
   .card-body {
     overflow: hidden;
     max-height: 0;
     transition: max-height var(--duration-normal) ease;
   }

   /* When hidden attribute is removed, allow height to grow */
   .card-body:not([hidden]) {
     max-height: 600px;
   }

/* Divider */
    .card-divider {
      border: none;
      border-top: 1px solid var(--color-primitive-twilight-indigo);
      margin: var(--spacing-6) 0 var(--spacing-md) 0;
    }

/* Achievements */
   .card-achievements {
     display: flex;
     flex-direction: column;
     gap: var(--spacing-12);
   }

  .achievements-title {
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-bold);
    color: var(--color-text-primary);
    margin: 0 0 4px 0;
  }

  .achievement-item {
    display: flex;
    gap: 8px;
    align-items: flex-start;
  }

  .bullet {
    color: var(--color-interactive-primary);
    font-size: var(--font-size-xs);
    line-height: 1.6;
    flex-shrink: 0;
  }

  .achievement-item span:last-child {
    font-size: var(--font-size-xs);
    color: var(--color-text-secondary);
    line-height: 1.6;
  }

  /* Responsive */
  @media (max-width: 767px) {
    .experience-card {
      padding: 12px 16px;
    }
  }

  @media (min-width: 768px) and (max-width: 1023px) {
    .experience-card {
      padding: 16px 20px;
    }
  }
</style>

<script>
  // Delegated accordion handler — runs once per page load
  (function () {
      function toggleCard(card: HTMLElement) {
        const isExpanded = card.getAttribute('aria-expanded') === 'true';
        const body = card.querySelector<HTMLElement>('.card-body');
        const marker = card.querySelector<HTMLElement>('.card-ascii-marker');

        if (!body) return;

        if (isExpanded) {
          // Collapse
          card.setAttribute('aria-expanded', 'false');
          card.classList.remove('is-expanded');
          body.setAttribute('hidden', '');
          if (marker) marker.textContent = '[+]';
        } else {
          // Expand
          card.setAttribute('aria-expanded', 'true');
          card.classList.add('is-expanded');
          body.removeAttribute('hidden');
          if (marker) marker.textContent = '[-]';
        }
      }

    // Click delegation
    document.addEventListener('click', (event: MouseEvent) => {
      const target = event.target as HTMLElement;
      const card = target.closest<HTMLElement>('.experience-card[role="button"]');
      if (card) {
        toggleCard(card);
      }
    });

    // Keyboard delegation (Enter / Space)
    document.addEventListener('keydown', (event: KeyboardEvent) => {
      if (event.key !== 'Enter' && event.key !== ' ') return;
      const target = event.target as HTMLElement;
      const card = target.closest<HTMLElement>('.experience-card[role="button"]');
      if (card) {
        event.preventDefault(); // prevent page scroll on Space
        toggleCard(card);
      }
    });
  })();
</script>
