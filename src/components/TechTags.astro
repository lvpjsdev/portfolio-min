---
import SkillTag from './SkillTag.astro';
import SkillIcon from './SkillIcon.astro';
import { skillLinks } from '../lib/skillLinks';

interface Props {
  technologies: string[];
}

const { technologies } = Astro.props;

const tags = technologies.map((tech) => ({
  tech,
  href: skillLinks[tech],
}));
---

<div class="tech-tags">
{tags.map(({ tech, href }) =>
  href ? (
    <SkillTag label={tech} href={href}>
      <SkillIcon name={tech} slot="icon" />
    </SkillTag>
  ) : (
    <SkillTag label={tech}>
      <SkillIcon name={tech} slot="icon" />
    </SkillTag>
  )
)}
</div>

  <style>
    .tech-tags {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      font-family: var(--font-family-mono);
    }

    .tech-tags, .skill-tag { font-family: var(--font-family-mono); }
    .tag, .skill-tag { border-radius: var(--design-rounded-sm, 4px); }
    .skill-tag { font-size: 14px; line-height: 2; }
  </style>