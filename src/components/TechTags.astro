---
import SkillTag from './SkillTag.astro';
import SkillIcon from './SkillIcon.astro';
import { skillLinks } from '../lib/skillLinks';

interface Props {
  skills: { name: string; icon?: string }[];
}

const { skills } = Astro.props;

const tags = skills.map((skill) => ({
  name: skill.name,
  icon: skill.icon,
  href: skillLinks[skill.name],
}));
---

<div class="tech-tags">
{tags.map(({ name, icon, href }) =>
  href ? (
    <SkillTag label={name} href={href}>
      {icon && <SkillIcon name={name} icon={icon} slot="icon" />}
    </SkillTag>
  ) : (
    <SkillTag label={name}>
      {icon && <SkillIcon name={name} icon={icon} slot="icon" />}
    </SkillTag>
  )
)}
</div>

  <style>
    .tech-tags {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      font-family: var(--font-family-mono);
    }

    .tech-tags, .skill-tag { font-family: var(--font-family-mono); }
    .tag, .skill-tag { border-radius: var(--design-rounded-sm, 4px); }
    .skill-tag { font-size: 14px; line-height: 2; }
  </style>