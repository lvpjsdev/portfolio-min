---
interface Props {
  title: string;
  subtitle: string;
  shortDescription: string;
  fullDescription: string;
  technologies: string[];
  liveUrl?: string;
  codeUrl?: string;
}

const {
  title,
  subtitle,
  shortDescription,
  fullDescription,
  technologies,
  liveUrl,
  codeUrl,
} = Astro.props;
---

<article
  class="project-card"
  role="button"
  tabindex="0"
  aria-expanded="false"
  aria-label={`${title} — ${subtitle}`}
>
  <!-- Collapsed: header row -->
  <div class="card-header">
    <div class="card-info">
      <span class="card-title">{title}</span>
      <span class="card-subtitle">{subtitle}</span>
    </div>
    <svg
      class="card-chevron"
      width="20"
      height="20"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <polyline points="9 18 15 12 9 6"></polyline>
    </svg>
  </div>

  <!-- Collapsed: short description -->
  <p class="card-short-desc">{shortDescription}</p>

  <!-- Collapsed: technology tags (inline SkillTag style, no import) -->
  <div class="card-tags">
    {technologies.map((tech) => (
      <span class="tech-tag">{tech}</span>
    ))}
  </div>

  <!-- Expanded body -->
  <div class="card-body" hidden>
    <hr class="card-divider" />

    <!-- Full description section -->
    <div class="card-section">
      <p class="section-title">Description:</p>
      <p class="section-text">{fullDescription}</p>
    </div>

    <!-- Technologies section -->
    <div class="card-section">
      <p class="section-title">Technologies:</p>
      <div class="card-tags card-tags--expanded">
        {technologies.map((tech) => (
          <span class="tech-tag">{tech}</span>
        ))}
      </div>
    </div>

    <!-- Links section (only if at least one URL is provided) -->
    {(liveUrl || codeUrl) && (
      <div class="card-links">
        {liveUrl && (
          <a
            href={liveUrl}
            class="card-btn card-btn--live"
            target="_blank"
            rel="noopener noreferrer"
            tabindex="-1"
          >
            Live Demo
          </a>
        )}
        {codeUrl && (
          <a
            href={codeUrl}
            class="card-btn card-btn--code"
            target="_blank"
            rel="noopener noreferrer"
            tabindex="-1"
          >
            View Code
          </a>
        )}
      </div>
    )}
  </div>
</article>

<style>
.project-card {
      --card-hover-bg: #4a2f5e;

      display: flex;
      flex-direction: column;
      gap: 16px;
     padding: 20px 24px;
     border-radius: var(--border-radius-lg);
     background-color: var(--color-background-surface);
     cursor: pointer;
     outline: none;
     transform: rotate(-0.030175490354247825deg);
     transition:
       background-color var(--duration-fast) ease,
       box-shadow var(--duration-fast) ease;
   }

  .project-card:hover,
  .project-card:focus-visible {
    background-color: var(--card-hover-bg);
  }

  .project-card:focus-visible {
    box-shadow: 0 0 0 2px var(--color-interactive-primary);
  }

  .project-card:hover .card-chevron,
  .project-card:focus-visible .card-chevron {
    color: var(--color-interactive-primary);
  }

  /* Header row */
  .card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
  }

/* Info column */
   .card-info {
     display: flex;
     flex-direction: column;
     gap: var(--spacing-6);
     min-width: 0;
   }

  .card-title {
    font-size: var(--font-size-base);
    font-weight: var(--font-weight-bold);
    color: var(--color-text-primary);
    line-height: 1.3;
  }

  .card-subtitle {
    font-size: var(--font-size-xs);
    color: var(--color-interactive-secondary);
    line-height: 1.3;
  }

  /* Chevron */
  .card-chevron {
    flex-shrink: 0;
    width: 20px;
    height: 20px;
    color: var(--color-text-secondary);
    transition:
      transform var(--duration-fast) ease,
      color var(--duration-fast) ease;
  }

/* Expanded state */
   .project-card.is-expanded {
     padding: 24px 28px;
   }

   .project-card.is-expanded .card-chevron {
     transform: rotate(90deg);
   }

  /* Short description */
  .card-short-desc {
    font-size: var(--font-size-xs);
    color: var(--color-text-secondary);
    line-height: 1.6;
    margin: 0;
  }

  /* Technology tags (collapsed + expanded) */
  .card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .tech-tag {
    display: inline-flex;
    align-items: center;
    padding: 6px 12px;
    border-radius: var(--border-radius-sm);
    background-color: var(--color-primitive-twilight-indigo);
    color: var(--color-primitive-white);
    font-size: var(--font-size-xs);
    line-height: 1;
    white-space: nowrap;
    transition: opacity var(--duration-fast) ease;
    cursor: default;
  }

  .tech-tag:hover {
    opacity: 0.8;
  }

  /* Body / accordion panel */
  .card-body {
    overflow: hidden;
    max-height: 0;
    transition: max-height var(--duration-normal) ease;
  }

  .card-body:not([hidden]) {
    max-height: 800px;
  }

  /* Divider */
  .card-divider {
    border: none;
    border-top: 1px solid var(--color-primitive-twilight-indigo);
    margin: 6px 0 16px 0;
  }

/* Sections inside expanded body */
    .card-section {
      display: flex;
      flex-direction: column;
      gap: var(--spacing-md);
      margin-bottom: 16px;
    }

  .section-title {
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-bold);
    color: var(--color-text-primary);
    margin: 0;
  }

  .section-text {
    font-size: var(--font-size-xs);
    color: var(--color-text-secondary);
    line-height: 1.6;
    margin: 0;
  }

  /* Links section */
  .card-links {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 4px;
  }

  .card-btn {
    display: inline-flex;
    align-items: center;
    padding: 10px 16px;
    border-radius: var(--border-radius-md);
    color: var(--color-primitive-white);
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-medium);
    text-decoration: none;
    transition: opacity var(--duration-fast) ease;
    cursor: pointer;
  }

  .card-btn:hover {
    opacity: 0.85;
  }

  .card-btn--live {
    background-color: var(--color-interactive-primary);
  }

  .card-btn--code {
    background-color: var(--color-primitive-twilight-indigo);
  }

  /* Responsive */
  @media (max-width: 767px) {
    .project-card {
      padding: 12px 16px;
    }
  }

  @media (min-width: 768px) and (max-width: 1023px) {
    .project-card {
      padding: 16px 20px;
    }
  }
</style>

<script>
  // Delegated accordion handler for project cards — runs once per page load
  (function () {
    function toggleCard(card: HTMLElement) {
      const isExpanded = card.getAttribute('aria-expanded') === 'true';
      const body = card.querySelector<HTMLElement>('.card-body');

      if (!body) return;

      if (isExpanded) {
        // Collapse
        card.setAttribute('aria-expanded', 'false');
        card.classList.remove('is-expanded');
        body.setAttribute('hidden', '');
      } else {
        // Expand
        card.setAttribute('aria-expanded', 'true');
        card.classList.add('is-expanded');
        body.removeAttribute('hidden');
      }
    }

    // Click delegation
    document.addEventListener('click', (event: MouseEvent) => {
      const target = event.target as HTMLElement;
      // Prevent toggling when clicking on links inside the expanded body
      if (target.closest('a')) return;
      const card = target.closest<HTMLElement>('.project-card[role="button"]');
      if (card) {
        toggleCard(card);
      }
    });

    // Keyboard delegation (Enter / Space)
    document.addEventListener('keydown', (event: KeyboardEvent) => {
      if (event.key !== 'Enter' && event.key !== ' ') return;
      const target = event.target as HTMLElement;
      const card = target.closest<HTMLElement>('.project-card[role="button"]');
      if (card) {
        event.preventDefault(); // prevent page scroll on Space
        toggleCard(card);
      }
    });
  })();
</script>
