---
import Layout from '../layouts/Layout.astro';
---

<Layout currentPage="home" title="Portfolio — Home">
  <section class="hero-section">
    <h1 class="hero-heading">Hej.</h1>
    <p class="hero-subtitle">My name is Leonid. I'm a Web Developer, creating digital experiences.</p>
  </section>
</Layout>

<style>
  .hero-section {
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: 100vh;
    padding: 0 80px;
  }

  .hero-heading {
    font-size: var(--font-size-7xl);
    font-weight: var(--font-weight-bold);
    color: var(--color-text-primary);
    margin: 0;
    line-height: 1;
  }

.hero-subtitle {
     font-size: 22px;
     color: var(--color-text-secondary);
     margin: var(--spacing-lg) 0 0 0;
     max-width: 600px;
     line-height: 1.4;
   }
</style>
