---
import Layout from '../../layouts/Layout.astro';
import { t } from '../../lib/i18n';
import ContactLink from '../../components/ContactLink.astro';

export function getStaticPaths() {
  return [
    { params: { lang: 'en' } },
    { params: { lang: 'ru' } },
  ];
}

interface ContactEntry {
  type: 'email' | 'linkedin' | 'github' | 'instagram';
  label: string;
  value: string;
}

const { lang } = Astro.params;

const contactLabels: Record<'email' | 'linkedin' | 'github' | 'instagram', string> = {
  email: t(lang, 'contact.email'),
  linkedin: t(lang, 'contact.linkedin'),
  github: t(lang, 'contact.github'),
  instagram: t(lang, 'contact.instagram'),
};

const contacts: ContactEntry[] = [
  {
    type: 'email',
    label: contactLabels.email,
    value: 'hello@example.com',
  },
  {
    type: 'linkedin',
    label: contactLabels.linkedin,
    value: 'https://linkedin.com/in/example',
  },
  {
    type: 'github',
    label: contactLabels.github,
    value: 'https://github.com/example',
  },
  {
    type: 'instagram',
    label: contactLabels.instagram,
    value: 'https://instagram.com/example',
  },
];
---

<Layout currentPage="contact" title={t(lang, 'contact.title')} lang={lang}>
  <section class="page-section">
    <div class="section-header">
      <h1 class="section-title">{t(lang, 'contact.heading')}</h1>
      <div class="section-divider"></div>
    </div>
    <div class="contacts-list">
      {contacts.map((contact) => (
        <ContactLink
          type={contact.type}
          label={contact.label}
          value={contact.value}
        />
      ))}
    </div>
  </section>
</Layout>

<style>
  .page-section {
    padding: var(--design-spacing-section, 96px) var(--spacing-md, 16px);
    max-width: 600px;
  }

  .section-header {
    margin-bottom: var(--spacing-xl);
  }

  .section-title {
    font-size: var(--typography-heading-md);
    font-weight: var(--font-weight-bold);
    color: var(--color-text-primary);
    margin: 0 0 var(--spacing-md) 0;
    line-height: 1.1;
  }

  .section-divider {
    height: 3px;
    width: 48px;
    background-color: var(--color-interactive-primary);
    border-radius: var(--border-radius-sm);
  }

  .contacts-list {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-md);
  }
</style>
