---
import Layout from '../../layouts/Layout.astro';
import { t } from '../../lib/i18n';

export function getStaticPaths() {
  return [
    { params: { lang: 'en' } },
    { params: { lang: 'ru' } },
  ];
}

const { lang } = Astro.params;
---

<Layout currentPage="about" title={t(lang, 'about.title')} lang={lang}>
  <section class="page-section">
    <div class="section-header">
      <h1 class="section-title">{t(lang, 'about.heading')}</h1>
      <div class="section-divider"></div>
    </div>
    <div class="section-content">
      <p class="bio-text">{t(lang, 'about.bio1')}</p>
      <p class="bio-text">{t(lang, 'about.bio2')}</p>
    </div>
  </section>
</Layout>

<style>
  .page-section {
    padding: var(--design-spacing-section, 96px) var(--spacing-md, 16px);
    max-width: 800px;
  }

  .section-header {
    margin-bottom: var(--spacing-xl);
  }

  .section-title {
    font-size: var(--typography-heading-md);
    font-weight: var(--font-weight-bold);
    color: var(--color-text-primary);
    margin: 0 0 var(--spacing-md) 0;
    line-height: 1.1;
  }

  .section-divider {
    height: 3px;
    width: 48px;
    background-color: var(--color-interactive-primary);
    border-radius: var(--border-radius-sm);
  }

  .section-content {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-md);
  }

  .bio-text {
    font-size: var(--typography-body-md);
    font-weight: 400;
    color: var(--color-text-secondary);
    line-height: 1.7;
    margin: 0;
  }
</style>
