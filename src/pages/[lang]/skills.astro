---
import Layout from '../../layouts/Layout.astro';
import TechTags from '../../components/TechTags.astro';
import { getCollection } from 'astro:content';

export function getStaticPaths() {
  return [
    { params: { lang: 'en' } },
    { params: { lang: 'ru' } },
  ];
}

const { lang } = Astro.params;
const allSkills = await getCollection('skills');
const filteredSkills = allSkills.filter(s => s.data.lang === lang);

// Group skills by category
const skillsByCategory = filteredSkills.reduce((acc, skill) => {
  const category = skill.data.category;
  if (!acc[category]) {
    acc[category] = [];
  }
  acc[category].push(skill.data.name);
  return acc;
}, {} as Record<string, string[]>);

const skillCategories = Object.entries(skillsByCategory).map(([name, skills]) => ({
  name,
  skills,
}));
---
---

<Layout currentPage="skills" lang={lang} title="Portfolio — Skills">
  <section class="page-section">
    <div class="section-header">
      <h1 class="section-title">Skills</h1>
      <div class="section-divider"></div>
    </div>
    <div class="categories-list">
      {skillCategories.map((category) => (
        <div class="category">
          <h2 class="category-title">{category.name}</h2>
          <div class="tags-list">
            <TechTags technologies={category.skills} />
          </div>
        </div>
      ))}
    </div>
  </section>
</Layout>

<style>
  .page-section {
    padding: var(--design-spacing-section, 96px) var(--spacing-md, 16px);
    max-width: 800px;
  }

  .section-header {
    margin-bottom: var(--spacing-xl);
  }

  .section-title {
    font-size: var(--typography-heading-md);
    font-weight: var(--font-weight-bold);
    color: var(--color-text-primary);
    margin: 0 0 var(--spacing-md) 0;
    line-height: 1.1;
  }

  .section-divider {
    height: 3px;
    width: 48px;
    background-color: var(--color-interactive-primary);
    border-radius: var(--border-radius-sm);
  }

  .categories-list {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-lg);
  }

  .category-title {
    font-size: var(--typography-body-md);
    font-weight: 400;
    font-weight: var(--font-weight-medium);
    color: var(--color-text-primary);
    margin: 0 0 var(--spacing-sm) 0;
  }

  .tags-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-sm);
  }
</style>
