---
import Layout from '../layouts/Layout.astro';
import SkillTag from '../components/SkillTag.astro';

interface SkillCategory {
  name: string;
  skills: Array<{ label: string; accent?: boolean }>;
}

const skillCategories: SkillCategory[] = [
  {
    name: 'Web Technologies',
    skills: [
      { label: 'TypeScript', accent: true },
      { label: 'React', accent: true },
      { label: 'Astro' },
      { label: 'HTML5' },
      { label: 'CSS3' },
    ],
  },
  {
    name: 'Backend & Tools',
    skills: [
      { label: 'Node.js' },
      { label: 'PostgreSQL' },
      { label: 'Git' },
      { label: 'Docker' },
    ],
  },
  {
    name: 'Design',
    skills: [
      { label: 'Figma' },
      { label: 'Design Systems' },
      { label: 'CSS Tokens' },
    ],
  },
];
---

<Layout currentPage="skills" title="Portfolio — Skills">
  <section class="page-section">
    <div class="section-header">
      <h1 class="section-title">Skills</h1>
      <div class="section-divider"></div>
    </div>
    <div class="categories-list">
      {skillCategories.map((category) => (
        <div class="category">
          <h2 class="category-title">{category.name}</h2>
          <div class="tags-list">
            {category.skills.map((skill) => (
              <SkillTag label={skill.label} accent={skill.accent} />
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>
</Layout>

<style>
  .page-section {
    padding: 4rem 3rem;
    max-width: 800px;
  }

  .section-header {
    margin-bottom: 2rem;
  }

  .section-title {
    font-size: var(--font-size-2xl);
    font-weight: var(--font-weight-bold);
    color: var(--color-text-primary);
    margin: 0 0 0.75rem 0;
  }

  .section-divider {
    height: 3px;
    width: 48px;
    background-color: var(--color-interactive-primary);
    border-radius: var(--border-radius-full);
  }

  .categories-list {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .category-title {
    font-size: var(--font-size-base);
    font-weight: var(--font-weight-medium);
    color: var(--color-text-primary);
    margin: 0 0 0.75rem 0;
  }

  .tags-list {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
</style>
