---
import Layout from '../layouts/Layout.astro';
import TechTags from '../components/TechTags.astro';

interface SkillCategory {
  name: string;
  skills: string[];
}

const skillCategories: SkillCategory[] = [
  {
    name: 'Web Technologies',
    skills: ['TypeScript', 'React', 'Astro', 'HTML', 'CSS'],
  },
  {
    name: 'Backend & Tools',
    skills: ['Node.js', 'PostgreSQL', 'Git'],
  },
  {
    name: 'Design',
    skills: ['Figma', 'Design Systems', 'CSS Tokens'],
  },
];
---
---

<Layout currentPage="skills" title="Portfolio — Skills">
  <section class="page-section">
    <div class="section-header">
      <h1 class="section-title">Skills</h1>
      <div class="section-divider"></div>
    </div>
    <div class="categories-list">
      {skillCategories.map((category) => (
        <div class="category">
          <h2 class="category-title">{category.name}</h2>
          <div class="tags-list">
            <TechTags technologies={category.skills} />
          </div>
        </div>
      ))}
    </div>
  </section>
</Layout>

<style>
  .page-section {
    padding: var(--design-spacing-section, 96px) var(--spacing-md, 16px);
    max-width: 800px;
  }

  .section-header {
    margin-bottom: var(--spacing-xl);
  }

  .section-title {
    font-size: var(--typography-heading-md);
    font-weight: var(--font-weight-bold);
    color: var(--color-text-primary);
    margin: 0 0 var(--spacing-md) 0;
    line-height: 1.1;
  }

  .section-divider {
    height: var(--divider-height);
    width: 48px;
    background-color: var(--color-interactive-primary);
    border-radius: var(--border-radius-sm);
  }

  .categories-list {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-lg);
  }

  .category-title {
    font-size: var(--typography-body-md);
    font-weight: 400;
    font-weight: var(--font-weight-medium);
    color: var(--color-text-primary);
    margin: 0 0 var(--spacing-sm) 0;
  }

  .tags-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-sm);
  }
</style>
