---
import Layout from '../layouts/Layout.astro';
import ContactLink from '../components/ContactLink.astro';

interface ContactEntry {
  type: 'email' | 'linkedin' | 'github' | 'instagram';
  label: string;
  value: string;
}

const contacts: ContactEntry[] = [
  {
    type: 'email',
    label: 'Email',
    value: 'hello@example.com',
  },
  {
    type: 'linkedin',
    label: 'LinkedIn',
    value: 'https://linkedin.com/in/example',
  },
  {
    type: 'github',
    label: 'GitHub',
    value: 'https://github.com/example',
  },
  {
    type: 'instagram',
    label: 'Instagram',
    value: 'https://instagram.com/example',
  },
];
---

<Layout currentPage="contact" title="Portfolio — Contact">
  <section class="page-section">
    <div class="section-header">
      <h1 class="section-title">Contact</h1>
      <div class="section-divider"></div>
    </div>
    <div class="contacts-list">
      {contacts.map((contact) => (
        <ContactLink
          type={contact.type}
          label={contact.label}
          value={contact.value}
        />
      ))}
    </div>
  </section>
</Layout>

<style>
  .page-section {
    padding: var(--design-spacing-section, 96px) var(--spacing-md, 16px);
    max-width: 600px;
  }

  .section-header {
    margin-bottom: var(--spacing-xl);
  }

  .section-title {
    font-size: var(--typography-heading-md);
    font-weight: var(--font-weight-bold);
    color: var(--color-text-primary);
    margin: 0 0 var(--spacing-md) 0;
    line-height: 1.1;
  }

  .section-divider {
    height: var(--divider-height);
    width: 48px;
    background-color: var(--color-interactive-primary);
    border-radius: var(--border-radius-sm);
  }

  .contacts-list {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-md);
  }
</style>
