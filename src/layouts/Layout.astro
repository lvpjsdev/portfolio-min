---
import Sidebar from '../components/Sidebar.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import '../styles/tokens.css';
import '../styles/globals.css';

interface Props {
  currentPage: 'home' | 'about' | 'experience' | 'projects' | 'skills' | 'contact';
  title?: string;
  lang?: string;
}

const { currentPage, title = 'Portfolio', lang: propLang } = Astro.props;
const lang = propLang || (Astro.url?.pathname.startsWith('/ru') ? 'ru' : 'en');
const isRu = lang === 'ru';
const currentPath = Astro.url?.pathname || '/';
const cleanPath = currentPath.replace(/^\/(ru|en)/, '').replace(/\/$/, '') || '/';
---

<!doctype html>
<html lang={lang} data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <!-- Theme init script: runs before render to prevent FOUC -->
    <script>
      (function() {
        // Theme persistence
        try {
          var stored = localStorage.getItem('theme');
          if (stored === 'dark' || stored === 'light') {
            document.documentElement.setAttribute('data-theme', stored);
          }
        } catch(_) {}
        if (!document.documentElement.hasAttribute('data-theme') && window.matchMedia && window.matchMedia('(prefers-color-scheme: light)').matches) {
          document.documentElement.setAttribute('data-theme', 'light');
        }
        // Language persistence - redirect to stored language if on root path
        try {
          var storedLang = localStorage.getItem('lang');
          var pathParts = window.location.pathname.split('/');
          // If no language prefix in path and we have stored preference
          if (storedLang && (pathParts[1] !== 'en' && pathParts[1] !== 'ru')) {
            var cleanPath = window.location.pathname.replace(/^\/(ru|en)/, '').replace(/\/$/, '') || '/';
            var newPath = '/' + storedLang + cleanPath;
            window.location.replace(newPath);
          }
        } catch(_) {}
      })();
    </script>
  </head>
  <body>
    <Sidebar currentPage={currentPage} />
    <div class="top-controls">
      <div class="lang-toggle-wrapper">
        <a href={isRu ? `/en${cleanPath}` : cleanPath} class:list={['lang-toggle', { 'lang-toggle--active': !isRu }]} aria-label="Switch to English" onclick="localStorage.setItem('lang', 'en')">EN</a>
        <a href={`/ru${cleanPath}`} class:list={['lang-toggle', { 'lang-toggle--active': isRu }]} aria-label="Switch to Russian" onclick="localStorage.setItem('lang', 'ru')">RU</a>
      </div>
      <div class="theme-toggle-wrapper">
        <ThemeToggle />
      </div>
    </div>
    <main class="main-content">
      <slot />
    </main>
  </body>
</html>

<style>
  html {
    margin: 0;
    width: 100%;
    min-height: 100%;
  }

  body {
    margin: 0;
    width: 100%;
    min-height: 100%;
    background-color: var(--color-background-page);
    color: var(--color-text-primary);
    font-family: var(--font-family-mono);
    position: relative;
  }

  .top-controls {
    position: fixed;
    top: 1rem;
    right: 1rem;
    z-index: 999;
    display: flex;
    gap: 8px;
    align-items: center;
  }

  .theme-toggle-wrapper {
    /* ThemeToggle is already styled internally */
  }

  .lang-toggle-wrapper {
    display: flex;
    gap: 4px;
    background: var(--color-primitive-twilight-indigo);
    border-radius: var(--border-radius-20);
    padding: 6px 10px;
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.15);
  }

  .lang-toggle {
    color: var(--color-primitive-silver-mist);
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-medium);
    text-decoration: none;
    padding: 2px 6px;
    border-radius: var(--border-radius-sm);
    transition: background-color var(--duration-fast) ease, color var(--duration-fast) ease;
  }

  .lang-toggle:hover {
    background-color: rgba(244, 96, 54, 0.2);
    color: var(--color-primitive-white);
  }

  .lang-toggle--active {
    background-color: var(--color-primitive-tiger-flame);
    color: var(--color-primitive-white);
  }

  .main-content {
    max-width: 960px;
    margin: 0 auto;
    padding: 0 var(--font-size-sm, 16px);
    min-height: 100vh;
  }

  /* 96px section spacing between direct children */
  .main-content > section,
  .main-content > div > section {
    margin-bottom: var(--design-spacing-section, 96px);
  }

  .main-content > section:last-child,
  .main-content > div > section:last-child {
    margin-bottom: 0;
  }

  @media (max-width: 767px) {
    .main-content {
      margin-left: 0;
      padding-top: 56px; /* height of mobile nav */
    }

    .top-controls {
      top: auto;
      bottom: 1rem;
      right: 1rem;
    }
  }
</style>
