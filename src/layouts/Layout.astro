---
import Sidebar from '../components/Sidebar.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import '../styles/tokens.css';
import '../styles/globals.css';

interface Props {
  currentPage: 'home' | 'about' | 'experience' | 'projects' | 'skills' | 'contact';
  title?: string;
  lang?: string;
}

const { currentPage, title = 'Portfolio', lang = 'en' } = Astro.props;
const isRu = lang === 'ru';
---

<!doctype html>
<html lang={lang} data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <link href="https://fonts.googleapis.com/css2?family=Bacasime+Antique:wght@400;700&family=Libertinus+Sans:wght@400;500;700&display=swap" rel="stylesheet">
    <!-- Theme init script: runs before render to prevent FOUC -->
    <script>
      (function() {
        try {
          var stored = localStorage.getItem('theme');
          if (stored === 'dark' || stored === 'light') {
            document.documentElement.setAttribute('data-theme', stored);
            return;
          }
        } catch(_) {}
        if (window.matchMedia && window.matchMedia('(prefers-color-scheme: light)').matches) {
          document.documentElement.setAttribute('data-theme', 'light');
        }
      })();
    </script>
  </head>
  <body>
    <Sidebar currentPage={currentPage} />
    <div class="top-controls">
      <div class="lang-toggle-wrapper">
        <a href="/en" class:list={['lang-toggle', { 'lang-toggle--active': !isRu }]} aria-label="Switch to English">EN</a>
        <a href="/ru" class:list={['lang-toggle', { 'lang-toggle--active': isRu }]} aria-label="Switch to Russian">RU</a>
      </div>
      <div class="theme-toggle-wrapper">
        <ThemeToggle />
      </div>
    </div>
    <main class="main-content">
      <slot />
    </main>
  </body>
</html>

<style>
  html {
    margin: 0;
    width: 100%;
    min-height: 100%;
  }

  body {
    margin: 0;
    width: 100%;
    min-height: 100%;
    background-color: var(--color-background-page);
    color: var(--color-text-primary);
    font-family: var(--font-family-sans);
    position: relative;
  }

  .top-controls {
    position: fixed;
    top: 1rem;
    right: 1rem;
    z-index: 999;
    display: flex;
    gap: 8px;
    align-items: center;
  }

  .theme-toggle-wrapper {
    /* ThemeToggle is already styled internally */
  }

  .lang-toggle-wrapper {
    display: flex;
    gap: 4px;
    background: var(--color-primitive-twilight-indigo);
    border-radius: var(--border-radius-20);
    padding: 6px 10px;
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.15);
  }

  .lang-toggle {
    color: var(--color-primitive-silver-mist);
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-medium);
    text-decoration: none;
    padding: 2px 6px;
    border-radius: var(--border-radius-sm);
    transition: background-color var(--duration-fast) ease, color var(--duration-fast) ease;
  }

  .lang-toggle:hover {
    background-color: rgba(244, 96, 54, 0.2);
    color: var(--color-primitive-white);
  }

  .lang-toggle--active {
    background-color: var(--color-primitive-tiger-flame);
    color: var(--color-primitive-white);
  }

  .main-content {
    margin-left: 64px;
    min-height: 100vh;
  }

  @media (max-width: 767px) {
    .main-content {
      margin-left: 0;
      padding-top: 56px; /* height of mobile nav */
    }

    .top-controls {
      top: auto;
      bottom: 1rem;
      right: 1rem;
    }
  }
</style>
