{
  "color": {
    "primitive": {
      "$type": "color",
      "midnight-violet": { "$value": "#171123" },
      "dark-amethyst": { "$value": "#372248" },
      "tiger-flame": { "$value": "#f46036" },
      "dusty-denim": { "$value": "#5b85aa" },
      "twilight-indigo": { "$value": "#414770" },
      "silver-mist": { "$value": "#bbbcc4" },
      "white": { "$value": "#ffffff" },
      "black": { "$value": "#000000" }
    }
  },
  "spacing": {
    "$type": "dimension",
    "xxs": { "$value": "1px" },
    "xs": { "$value": "4px" },
    "sm": { "$value": "8px" },
    "md": { "$value": "12px" },
    "lg": { "$value": "16px" },
    "xl": { "$value": "24px" },
    "xxl": { "$value": "32px" },
    "section": { "$value": "96px" }
  },
  "rounded": {
    "$type": "dimension",
    "none": { "$value": "0px" },
    "sm": { "$value": "4px" },
    "full": { "$value": "9999px" }
  },
  "typography": {
    "$type": "typography",
    "display-xl": {
      "$value": {
        "fontFamily": "Berkeley Mono, IBM Plex Mono, ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, Liberation Mono, Courier New",
        "fontSize": "38px",
        "fontWeight": "700",
        "lineHeight": "1.5",
        "letterSpacing": "0"
      }
    },
    "heading-md": {
      "$value": {
        "fontFamily": "Berkeley Mono, IBM Plex Mono, ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, Liberation Mono, Courier New",
        "fontSize": "16px",
        "fontWeight": "700",
        "lineHeight": "1.5",
        "letterSpacing": "0"
      }
    },
    "body-md": {
      "$value": {
        "fontFamily": "Berkeley Mono, IBM Plex Mono, ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, Liberation Mono, Courier New",
        "fontSize": "16px",
        "fontWeight": "400",
        "lineHeight": "1.5",
        "letterSpacing": "0"
      }
    },
    "body-strong": {
      "$value": {
        "fontFamily": "Berkeley Mono, IBM Plex Mono, ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, Liberation Mono, Courier New",
        "fontSize": "16px",
        "fontWeight": "500",
        "lineHeight": "1.5",
        "letterSpacing": "0"
      }
    },
    "body-tight": {
      "$value": {
        "fontFamily": "Berkeley Mono, IBM Plex Mono, ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, Liberation Mono, Courier New",
        "fontSize": "16px",
        "fontWeight": "500",
        "lineHeight": "1",
        "letterSpacing": "0"
      }
    },
    "link-md": {
      "$value": {
        "fontFamily": "Berkeley Mono, IBM Plex Mono, ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, Liberation Mono, Courier New",
        "fontSize": "16px",
        "fontWeight": "400",
        "lineHeight": "1.5",
        "letterSpacing": "0"
      }
    },
    "button-md": {
      "$value": {
        "fontFamily": "Berkeley Mono, IBM Plex Mono, ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, Liberation Mono, Courier New",
        "fontSize": "16px",
        "fontWeight": "500",
        "lineHeight": "2",
        "letterSpacing": "0"
      }
    },
    "caption-md": {
      "$value": {
        "fontFamily": "Berkeley Mono, IBM Plex Mono, ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, Liberation Mono, Courier New",
        "fontSize": "14px",
        "fontWeight": "400",
        "lineHeight": "2",
        "letterSpacing": "0"
      }
    }
  }
}
