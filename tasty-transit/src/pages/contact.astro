---
import Layout from '../layouts/Layout.astro';
---

<Layout>
	<div class="flex min-h-screen">
		<nav class="fixed left-0 top-0 h-full w-16 bg-dark-amethyst flex flex-col items-center justify-center z-50">
			<div class="space-y-6">
				<a href="/" class="block w-3 h-3 rounded-full bg-tiger-flame transition-all hover:scale-150" title="Home"></a>
				<a href="/about" class="block w-3 h-3 rounded-full bg-tiger-flame transition-all hover:scale-150" title="About"></a>
				<a href="/experience" class="block w-3 h-3 rounded-full bg-tiger-flame transition-all hover:scale-150" title="Experience"></a>
				<a href="/projects" class="block w-3 h-3 rounded-full bg-tiger-flame transition-all hover:scale-150" title="Projects"></a>
				<a href="/skills" class="block w-3 h-3 rounded-full bg-tiger-flame transition-all hover:scale-150" title="Skills"></a>
				<a href="/contact" class="block w-3 h-3 rounded-full bg-tiger-flame transition-all hover:scale-150" title="Contact"></a>
			</div>
		</nav>
		
		<main class="flex-1 pl-16 py-16 pr-8">
			<h1 class="text-4xl font-bold mb-8 text-white">Contact</h1>
			<div class="space-y-4">
				<p class="text-dusty-denim">
					Get in touch via email or social media.
				</p>
				<div class="space-y-2">
					<p><span class="text-white">Email:</span> <a href="mailto:hello@example.com" class="text-tiger-flame hover:underline">hello@example.com</a></p>
				</div>
			</div>
		</main>
	</div>
</Layout>