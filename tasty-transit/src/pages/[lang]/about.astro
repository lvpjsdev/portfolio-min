---
import Layout from '../../layouts/Layout.astro';
import { getTranslations, getStaticPathsForLocale } from '../../i18n/translations';

export function getStaticPaths() {
  return getStaticPathsForLocale();
}

const { lang } = Astro.params;
const t = await getTranslations(lang as 'en' | 'ru');
---

<Layout>
	<div class="flex min-h-screen">
		<nav class="fixed left-0 top-0 h-full w-16 bg-dark-amethyst flex flex-col items-center justify-center z-50">
			<div class="space-y-6">
				<a href={`/${lang}/`} class="block w-3 h-3 rounded-full bg-tiger-flame transition-all hover:scale-150" title="Home"></a>
				<a href={`/${lang}/about`} class="block w-3 h-3 rounded-full bg-tiger-flame transition-all hover:scale-150" title="About"></a>
				<a href={`/${lang}/experience`} class="block w-3 h-3 rounded-full bg-tiger-flame transition-all hover:scale-150" title="Experience"></a>
				<a href={`/${lang}/projects`} class="block w-3 h-3 rounded-full bg-tiger-flame transition-all hover:scale-150" title="Projects"></a>
				<a href={`/${lang}/skills`} class="block w-3 h-3 rounded-full bg-tiger-flame transition-all hover:scale-150" title="Skills"></a>
				<a href={`/${lang}/contact`} class="block w-3 h-3 rounded-full bg-tiger-flame transition-all hover:scale-150" title="Contact"></a>
			</div>
		</nav>
		
		<main class="flex-1 pl-16 py-16 pr-8">
			<h1 class="text-4xl font-bold mb-8 text-white">{t.about.title}</h1>
			<div class="max-w-3xl">
				<p class="text-lg text-dusty-denim mb-4">
					Hello, world!
				</p>
				<p class="text-dusty-denim mb-4">
					I'm a web developer with experience in building modern web applications.
				</p>
			</div>
		</main>
	</div>
</Layout>