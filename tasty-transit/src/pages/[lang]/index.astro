---
import Layout from '../../layouts/Layout.astro';
import { getTranslations, getStaticPathsForLocale } from '../../i18n/translations';

export function getStaticPaths() {
  return getStaticPathsForLocale();
}

const { lang } = Astro.params;
const t = await getTranslations(lang as 'en' | 'ru');
---

<Layout>
	<div class="flex min-h-screen">
		<nav class="fixed left-0 top-0 h-full w-16 bg-dark-amethyst flex flex-col items-center justify-center z-50">
			<div class="space-y-6">
				<a href={`/${lang}/`} class="block w-3 h-3 rounded-full bg-tiger-flame" title={t.nav.home}></a>
				<a href={`/${lang}/about`} class="block w-3 h-3 rounded-full bg-tiger-flame" title={t.nav.about}></a>
				<a href={`/${lang}/experience`} class="block w-3 h-3 rounded-full bg-tiger-flame" title={t.nav.experience}></a>
				<a href={`/${lang}/projects`} class="block w-3 h-3 rounded-full bg-tiger-flame" title={t.nav.projects}></a>
				<a href={`/${lang}/skills`} class="block w-3 h-3 rounded-full bg-tiger-flame" title={t.nav.skills}></a>
				<a href={`/${lang}/contact`} class="block w-3 h-3 rounded-full bg-tiger-flame" title={t.nav.contact}></a>
			</div>
		</nav>
		
		<main class="flex-1 flex items-center justify-center pl-16">
			<div class="text-center">
				<h1 class="text-6xl md:text-8xl font-bold mb-4 text-white animate-fade-in-up">
					{t.home.greeting}
				</h1>
				<h2 class="text-xl text-dusty-denim animate-fade-in-up">
					{t.home.intro}
				</h2>
			</div>
		</main>
	</div>
</Layout>
